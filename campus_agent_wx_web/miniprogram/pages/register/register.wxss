.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 50rpx;
  background: linear-gradient(135deg, #10b981 0%, #14b8a6 50%, #3b82f6 100%);
}

.avatar {
  font-size: 80rpx;
  background: white;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.1);
}

.title {
  font-size: 52rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 60rpx;
  letter-spacing: 2rpx;
}

.input {
  width: 100%;
  background: white;
  border-radius: 50rpx;
  padding: 0 40rpx;
  margin-bottom: 30rpx;
  font-size: 30rpx;
  line-height: 90rpx;
  height: 90rpx;
  box-sizing: border-box;
  color: #333;
}

.input::placeholder {
  color: #bbb;
  font-size: 30rpx;
  line-height: 90rpx;
}

/* 密码输入组 */
.input-group {
  width: 100%;
  position: relative;
  margin-bottom: 30rpx;
}

.input-group .input {
  margin-bottom: 0;
  padding-right: 100rpx;
}

.eye-btn {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  font-size: 40rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.eye-btn::after {
  border: none;
}

/* 条款 */
.terms {
  display: flex;
  align-items: center;
  width: 100%;
  margin: 20rpx 0 40rpx;
}

.terms-text {
  color: white;
  font-size: 26rpx;
  margin-left: 20rpx;
}

/* 按钮 */
.register-btn {
  width: 100%;
  background: white;
  color: #10b981;
  border-radius: 50rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 20rpx;
  border: none;
  text-align: center;
  padding: 0;
}

.register-btn::after {
  border: none;
}

.login-btn {
  background: transparent;
  color: white;
  border: 2rpx solid white;
  border-radius: 50rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  margin-top: 30rpx;
  width: 100%;
  text-align: center;
  padding: 0;
}

.login-btn::after {
  border: none;
}

.error {
  margin-top: 30rpx;
  color: #ffcccc;
  font-size: 26rpx;
  text-align: center;
  background: rgba(255,0,0,0.2);
  padding: 20rpx;
  border-radius: 20rpx;
  width: 100%;
}